---
// Polices self-hébergées (@fontsource pose font-display: swap par défaut).
// Chaque fichier découpe ses sous-ensembles par unicode-range : le navigateur
// ne télécharge que le latin pour un site en français.
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/500.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import "@fontsource/montserrat/800.css";
import "@fontsource/montserrat/400-italic.css";
import "@fontsource/montserrat/700-italic.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";

// Préchargement des deux fichiers réellement critiques au premier rendu :
// Montserrat 400 (corps de texte) et Space Grotesk 700 (tous les titres).
import montserrat400 from "@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url";
import spaceGrotesk700 from "@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url";

import "../styles/style.scss";
import Navbar from "../components/Navbar.astro";
import SEO from "../components/SEO.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  pageClass?: string;
  mainClass?: string;
  jsonLd?: Record<string, unknown>[];
  breadcrumb?: { nom: string; url: string }[];
}

const {
  title,
  description,
  pageClass = "",
  mainClass = "",
  jsonLd,
  breadcrumb,
} = Astro.props;

// Note : pas de class="mode" sur <body>. Dans la version React,
// useThemeStore (qui posait cette classe) n'était importé nulle part :
// les règles body.mode de _colors.scss ne s'appliquaient donc jamais.
// Les activer ici modifierait le rendu. Commentaire côté serveur pour
// qu'il ne parte pas dans le HTML livré.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/Logo_sukiweb.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preload" as="font" type="font/woff2" href={montserrat400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={spaceGrotesk700} crossorigin />

    <SEO
      title={title}
      description={description}
      jsonLd={jsonLd}
      breadcrumb={breadcrumb}
    />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-GM6HT25D18"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-GM6HT25D18");
    </script>
  </head>
  <body>
    <div class={pageClass}>
      <div class="background-color">
        <div class="header-main">
          <header>
            <Navbar />
            <slot name="banner" />
          </header>
          <main class={mainClass}>
            <slot />
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </body>
</html>
