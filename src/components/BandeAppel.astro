---
import { BOOKING_URL } from "../lib/site";

interface Props {
  /** Titre de la bande, propre à chaque page. */
  titre: string;
}

const { titre } = Astro.props;
---

<section class="bande-appel">
  <div class="conteneur bande-appel-bloc">
    <h2>{titre}</h2>
    <a
      class="bouton bouton--clair"
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      Réserver un appel de 30 min
    </a>
  </div>
</section>
