---
import type { CollectionEntry } from "astro:content";
import ProjectVisuel from "./ProjectVisuel.astro";

interface Props {
  projet: CollectionEntry<"projets">;
  compact?: boolean;
}

const { projet, compact = false } = Astro.props;
const d = projet.data;

// Mise en page transitoire : la grille et les cartes définitives de la
// maquette arrivent aux étapes 4 et 5. Ici, seuls les champs du nouveau
// schéma sont câblés.
---

<div class:list={["card-works", compact && "card-works--compact"]}>
  <a href={`/realisations/${projet.id}/`} aria-label={`Voir le projet ${d.nomCourt}`}>
    <ProjectVisuel projet={projet} />
  </a>
  <div class="card-content">
    <div>
      <p class="work-category">{d.mention}</p>
      <h3>{d.titreCarte}</h3>
      <p class="work-statut">{d.statutAffiche}</p>
    </div>
    <a href={`/realisations/${projet.id}/`} class="btn-secondary">Voir le projet</a>
  </div>
</div>
