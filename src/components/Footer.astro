---
import { Image } from "astro:assets";
import Logo from "../assets/images/Logo_Sukiweb_color.webp";
import { SITE } from "../lib/site";

interface LienPage {
  href: string;
  libelle: string;
}

interface Props {
  /**
   * Troisième lien du pied de page, après Mentions légales et LinkedIn.
   * Déduit de la page courante par défaut ; `null` le supprime.
   */
  lienPage?: LienPage | null;
}

const ACCUEIL = { href: "/", libelle: "Accueil" };
const REALISATIONS = { href: "/realisations/", libelle: "Réalisations" };
const SERVICES = { href: "/services/", libelle: "Services" };

// Le troisième lien change selon la page, comme dans la maquette : il mène
// vers une autre section du site plutôt que de répéter la page courante.
function lienParDefaut(path: string): LienPage | null {
  if (path === "/") return null;
  if (path === "/realisations/") return ACCUEIL;
  if (path === "/a-propos/") return SERVICES;
  return REALISATIONS;
}

const { lienPage } = Astro.props;
const lien =
  lienPage === undefined ? lienParDefaut(Astro.url.pathname) : lienPage;

const LINKEDIN = SITE.reseaux[0];
---

<footer>
  <span class="footer-identite">
    <Image src={Logo} alt="" width={28} height={28} loading="lazy" />
    <span>
      {SITE.personne} – {SITE.nom} · {SITE.ville}, {SITE.region}<br />
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · SIRET {SITE.siret}
    </span>
  </span>

  <span class="footer-liens">
    <a href="/mentions-legales/">Mentions légales</a>
    <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    {lien && <a href={lien.href}>{lien.libelle}</a>}
  </span>
</footer>
