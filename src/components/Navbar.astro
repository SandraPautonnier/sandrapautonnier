---
import { Image } from "astro:assets";
import Logo from "../assets/images/Logo_Sukiweb_mono.webp";
import { BOOKING_URL, SITE } from "../lib/site";

// Trois entrées de menu, plus le bouton de réservation. "Accueil" passe par
// le logo, qui est le lien vers "/" : c'est la structure de la maquette.
const LIENS = [
  { href: "/realisations/", libelle: "Réalisations" },
  { href: "/services/", libelle: "Services" },
  { href: "/a-propos/", libelle: "À propos" },
];

// La classe "active" se résout au build depuis l'URL courante. Une fiche
// projet marque "Réalisations", une page d'offre marque "Services".
const path = Astro.url.pathname;
const estActif = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<div class="menu-nav">
  <a class="marque" href="/" aria-label={`${SITE.personne} - accueil`}>
    <Image class="logo" src={Logo} alt="" width={48} height={48} />
    <span class="marque-texte">
      <span class="marque-nom">{SITE.personne}</span>
      <span class="marque-enseigne">{SITE.nom}</span>
    </span>
  </a>

  <nav aria-label="Navigation principale">
    {/* Le bouton burger n'ouvre que la liste de liens : le bouton de
        réservation reste visible à toutes les largeurs. */}
    <div
      class="hamburger"
      role="button"
      tabindex="0"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <div class="bar" aria-hidden="true"></div>
      <div class="bar" aria-hidden="true"></div>
      <div class="bar" aria-hidden="true"></div>
    </div>

    <ul class="nav-ul" id="menu-principal">
      {
        LIENS.map((lien) => (
          <li class="nav-li">
            <a
              href={lien.href}
              class={estActif(lien.href) ? "active" : ""}
              aria-current={estActif(lien.href) ? "page" : undefined}
            >
              {lien.libelle}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="btn-rdv" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">
      Réserver un appel
    </a>
  </nav>
</div>

<script>
  // Même mécanique que depuis la migration : un seul écouteur sur .hamburger,
  // la croix remonte par bouillonnement. Seul ajout, aria-expanded, pour que
  // l'état du menu soit annoncé aux lecteurs d'écran.
  const nav = document.querySelector<HTMLElement>(".menu-nav nav");

  if (nav) {
    const hamburger = nav.querySelector<HTMLElement>(".hamburger");
    const navUl = nav.querySelector<HTMLElement>(".nav-ul");

    if (hamburger && navUl) {
      const BARS =
        '<div class="bar" aria-hidden="true"></div><div class="bar" aria-hidden="true"></div><div class="bar" aria-hidden="true"></div>';
      const CLOSE =
        '<span class="close-nav" role="button" tabindex="0" aria-label="Fermer le menu">×</span>';

      let menuOpen = false;

      const render = () => {
        navUl.classList.toggle("open", menuOpen);
        hamburger.innerHTML = menuOpen ? CLOSE : BARS;
        hamburger.setAttribute("aria-expanded", String(menuOpen));
        hamburger.setAttribute(
          "aria-label",
          menuOpen ? "Fermer le menu" : "Ouvrir le menu",
        );
      };

      const toggleMenu = () => {
        menuOpen = !menuOpen;
        render();
      };

      hamburger.addEventListener("click", toggleMenu);
      hamburger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggleMenu();
        }
      });

      // Fermeture au clic à l'extérieur, et à la touche Échap.
      document.addEventListener("mousedown", (e) => {
        if (menuOpen && !nav.contains(e.target as Node)) {
          menuOpen = false;
          render();
        }
      });
      document.addEventListener("keydown", (e) => {
        if (menuOpen && e.key === "Escape") {
          menuOpen = false;
          render();
          hamburger.focus();
        }
      });
    }
  }
</script>
