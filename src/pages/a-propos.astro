---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faCheckCircle, faFileArrowDown } from "@fortawesome/free-solid-svg-icons";

import BaseLayout from "../layouts/BaseLayout.astro";
import ImageProfile from "../assets/images/image_profil.webp";
import Sandra from "../assets/images/Portrait_Sandra.webp";
import Coupe from "../assets/images/Image_coupe.webp";

const competences = await getCollection("competences");

// L'âge est calculé au build (il part donc dans le HTML, visible des crawlers)
// puis rafraîchi côté client s'il a vieilli entre deux déploiements.
const BIRTH_DATE = "1992-07-28";
const calculerAge = (iso: string, ref = new Date()) => {
  const n = new Date(iso);
  let age = ref.getFullYear() - n.getFullYear();
  const m = ref.getMonth() - n.getMonth();
  if (m < 0 || (m === 0 && ref.getDate() < n.getDate())) age--;
  return age;
};
const age = calculerAge(BIRTH_DATE);

const parcours = [
  { periode: "2008-2010", titre: "BEP Métiers de la Mode" },
  { periode: "2012-2014", titre: "BAC PRO Commerce" },
  { periode: "2014-2016", titre: "Vendeuse Prêt-à-porter" },
  { periode: "2016-2017", titre: "Cheffe de projet évenementiel" },
  { periode: "2021-2024", titre: "Chargée de projets" },
  { periode: "2024-2025", titre: "Titre RNCP Développeur informatique" },
  { periode: "2025-auj.", titre: "Développeuse & Créatrice web intuitive" },
];
---

<BaseLayout
  title="sukiweb - Profil de Sandra Pautonnier, développeuse web"
  description="Profil de Sandra Pautonnier, développeuse web spécialisée en création de sites performants, modernes et sur-mesure. Découvrez son parcours, ses compétences techniques et ses réussites."
  pageClass="profile"
>
  <div class="banner" slot="banner" role="region" aria-label="Présentation - À propos">
    <Image src={ImageProfile} alt="Image dessin d'un portrait carte de visite de Sandra Pautonnier" loading="lazy" />
    <h1>A propos de Sandra Pautonnier</h1>
    <div class="card-banner">
      <p class="base-text">
        Développeuse & Créatrice web intuitive, je conçois des applications
        modernes centrées utilisateur avec React, Node.js et MongoDB.
      </p>
    </div>
  </div>

  <section class="hook-about margin">
    <h2>Qui suis-je?</h2>
    <div class="container-hook-about">
      <div class="text-hook-about">
        <div class="box">
          <Image src={Sandra} alt="Portrait de Sandra Pautonnier" loading="lazy" />
          <p class="base-text">
            <span>Sandra Pautonnier</span> Développeuse & Créatrice web intuitive
            de <span id="age-sandra" data-birth={BIRTH_DATE}>{age}</span> ans au Mans.
            J'aime analyser, créer et développer pour donner vie à des projets web
            uniques. <br />
            Mon parcours mêle artistique, commerce, gestion de projet, création de
            contenu et développement web. Une combinaison qui me permet de comprendre
            les besoins réels de mes clients.
          </p>
        </div>
        <a
          href="/CV-Sandra-Pautonnier.pdf"
          class="btn"
          target="_blank"
          rel="noreferrer"
          download
          aria-label="Télécharger le CV de Sandra en document pdf"
        >
          <FontAwesomeIcon icon={faFileArrowDown} /> Télécharger le CV
        </a>
      </div>
    </div>
    <p class="catch">
      Une développeuse qui parle votre langue (et aussi JavaScript !).
    </p>
  </section>

  <section>
    <h2>Mes compétences techniques</h2>
    <div class="technical-skills-grid">
      {
        competences.map((cat) => (
          <div class="skill-card">
            <h4>{cat.data.category}</h4>
            <ul class="skill-list">
              {cat.data.skills.map((skill) => (
                <li>
                  <FontAwesomeIcon icon={faCheckCircle} />
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="catch">
      Oui je m'interesse à tout, mais ce que je sais surtout faire c'est analyser
      les besoins <br /> et exploiter les outils adaptés à la situation en toute cohérence.
      <br />Chaque projet est une passion !
    </p>
  </section>

  <section>
    <h2>Mon parcours</h2>
    <div class="container-mobile">
      {
        parcours.map((etape) => (
          <div class="card insert">
            <span>{etape.periode}</span>
            <div class="center">
              <h3>{etape.titre}</h3>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="success">
    <h2>Mes réussites</h2>
    <div class="container-img-success">
      <Image src={Coupe} alt="Coupe de réussite" loading="lazy" />
      <ul class="container-success">
        <li><span class="bold">2010 :</span> Dans le domaine des Métiers de la Mode, j'ai été médaillée d'argent au concours départementale du Meilleur Apprenti de France.</li>
        <li><span class="bold">2017 :</span> Lors de mon service civique, j'ai organisé un séminaire de A à Z avec 5 établissements scolaires et des associations sur les thèmes du harcèlement scolaire et du décrochage scolaire.</li>
        <li><span class="bold">2021 :</span> Lors d'un évènement caritatif sur ma chaîne Twitch, j'ai récolté 1477€ pour l'association Endofrance.</li>
        <li><span class="bold">2023 :</span> Chez Enedis, j'ai été l'interlocutrice et référente de l'ACO (Automobile Club de l'Ouest) pour le centenaire des 24h du Mans (Bornes fixes).</li>
      </ul>
    </div>
    <a href="/realisations/" class="btn" aria-label="Accède à mon portfolio">Découvrez mes réalisations</a>
  </section>
</BaseLayout>

<script>
  // Corrige l'âge si le site n'a pas été redéployé depuis le dernier
  // anniversaire. La valeur du HTML reste correcte pour les crawlers.
  const el = document.getElementById("age-sandra");
  if (el?.dataset.birth) {
    const n = new Date(el.dataset.birth);
    const today = new Date();
    let age = today.getFullYear() - n.getFullYear();
    const m = today.getMonth() - n.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < n.getDate())) age--;
    if (String(age) !== el.textContent) el.textContent = String(age);
  }
</script>
