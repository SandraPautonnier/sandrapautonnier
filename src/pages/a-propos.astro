---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BandeAppel from "../components/BandeAppel.astro";
import Portrait from "../assets/images/Portrait_Sandra.webp";
import { SITE } from "../lib/site";

const POURQUOI = [
  {
    titre: "Double casquette",
    texte:
      "Je développe votre site et je pilote le projet : pas besoin de traduire entre un chef de projet et un développeur.",
  },
  {
    titre: "Habituée aux projets à enjeux",
    texte:
      "En 2023, chez Enedis, j'étais la référente de l'Automobile Club de l'Ouest pour les bornes de recharge du centenaire des 24 Heures du Mans.",
  },
  {
    titre: "Une seule interlocutrice",
    texte:
      "Vous parlez à la personne qui fait le travail, du premier échange au suivi après mise en ligne.",
  },
  {
    titre: "Un numérique responsable",
    texte:
      "Des sites légers, des données protégées et hébergées en Europe quand c'est possible, et une IA utilisée seulement quand elle est vraiment utile.",
  },
];

const PARCOURS = [
  {
    periode: "Depuis 2026",
    titre: "Sukiweb, mon activité indépendante",
    texte:
      "Création de sites, référencement, pilotage de projets numériques.",
  },
  {
    periode: "2024 – 2025",
    titre: "Titre RNCP Développeur informatique",
    texte:
      "Reconversion vers le développement web : front-end, back-end et projets en équipe.",
  },
  {
    periode: "2021 – 2024",
    titre: "Chargée de projets",
    texte:
      "Chez Enedis : assistante ingénieur projet, puis responsable des raccordements provisoires. Également au ministère de l'Agriculture, chez Dactem Développement et à l'Université du Mans.",
  },
  {
    periode: "2016 – 2017",
    titre: "Cheffe de projet événementiel",
    texte:
      "En service civique : organisation de A à Z d'un séminaire avec 5 établissements scolaires et des associations, sur le harcèlement et le décrochage scolaires.",
  },
  {
    periode: "2014 – 2016",
    titre: "Vendeuse en prêt-à-porter",
    texte:
      "Le commerce de l'intérieur : je sais ce qu'un client attend d'une boutique, en ligne comme en vrai.",
  },
];

const FORMATIONS = [
  { titre: "Titre RNCP Développeur informatique" },
  { titre: "Intégrateur web", precision: "· OpenClassrooms" },
  { titre: "BTS Assistant Manager" },
  { titre: "BAC PRO Commerce", precision: "· 2012 – 2014" },
];

// Le nœud Person du site est déjà posé par SEO.astro, avec l'identifiant
// #sandra auquel renvoient founder et author. On ne le redéclare pas ici :
// deux Person pour la même personne brouilleraient le graphe. On complète
// seulement le nœud existant avec ce que la page apporte.
const personne = {
  "@context": "https://schema.org",
  "@id": `${SITE.url}/#sandra`,
  mainEntityOfPage: new URL("/a-propos/", SITE.url).href,
  alumniOf: "Titre RNCP Développeur informatique",
  knowsAbout: [
    "Création de sites internet",
    "Référencement naturel",
    "Gestion de projet digital",
    "Automatisation et IA",
  ],
};

const breadcrumb = [
  { nom: "Accueil", url: "/" },
  { nom: "À propos", url: "/a-propos/" },
];
---

<BaseLayout
  title="Sandra Pautonnier, développeuse web au Mans | Sukiweb"
  description="Développeuse web et cheffe de projet digitale au Mans. Parcours, formations et façon de travailler : un site, c'est autant d'organisation que de code."
  pageClass="apropos"
  pleineLargeur
  jsonLd={[personne]}
  breadcrumb={breadcrumb}
>
  <section class="apropos-entete">
    <div class="conteneur apropos-entete-grille">
      <div class="apropos-entete-texte">
        <p class="apropos-accroche">Bonjour, moi c'est Sandra.</p>
        <h1>
          Sandra Pautonnier, développeuse web et cheffe de projet au Mans
        </h1>
        <p>
          Développeuse web et cheffe de projet digitale, installée en Sarthe.
          J'ai lancé mon activité en janvier 2026 après plusieurs années à
          piloter des projets, notamment chez Enedis.
        </p>
        <p>
          Ma conviction : un bon site, c'est autant une question d'organisation
          que de code. Je vous accompagne sur les deux.
        </p>
        <a
          class="bouton bouton--contour apropos-cv"
          href="/CV-Sandra-Pautonnier.pdf"
          target="_blank"
          rel="noreferrer"
          download
        >
          Télécharger le CV
        </a>
      </div>
      <Image
        class="apropos-portrait"
        src={Portrait}
        alt={`Portrait de ${SITE.personne}`}
        width={300}
        height={450}
      />
    </div>
  </section>

  <section class="apropos-pourquoi">
    <div class="conteneur apropos-pourquoi-bloc">
      <h2>Pourquoi travailler avec moi</h2>
      <div class="apropos-pourquoi-grille">
        {
          POURQUOI.map((point) => (
            <div class="apropos-point">
              <strong>{point.titre}</strong>
              <span>{point.texte}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="apropos-parcours">
    <div class="conteneur apropos-parcours-grille">
      <div class="apropos-frise-colonne">
        <h2>Parcours</h2>
        <ol class="apropos-frise">
          {
            PARCOURS.map((etape) => (
              <li>
                <span class="apropos-periode">{etape.periode}</span>
                <strong>{etape.titre}</strong>
                <span class="apropos-etape-texte">{etape.texte}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="apropos-formations-colonne">
        <h2>Formations</h2>
        <ul class="apropos-formations">
          {
            FORMATIONS.map((formation) => (
              <li>
                <strong>{formation.titre}</strong>
                {formation.precision && (
                  <span class="apropos-precision"> {formation.precision}</span>
                )}
              </li>
            ))
          }
        </ul>
        <div class="apropos-mode">
          <strong>Avant le web, la mode</strong>
          <span>
            BEP Métiers de la mode (2008 – 2010) et médaille d'argent au concours
            Meilleur Apprenti de France de la Sarthe en 2010. Le goût du détail
            et du travail fini vient de là.
          </span>
        </div>
      </div>
    </div>
  </section>

  <BandeAppel
    titre="On fait connaissance ?"
    secondaire={{ href: "/realisations/", libelle: "Voir mes réalisations" }}
  />
</BaseLayout>
