---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlocOffre from "../../components/BlocOffre.astro";
import BlocAssociations from "../../components/BlocAssociations.astro";
import Methode from "../../components/Methode.astro";
import Faq from "../../components/Faq.astro";
import BandeAppel from "../../components/BandeAppel.astro";
import {
  BLOCS,
  FAQ,
  GARANTIES_SERVICES,
  MENTION_TVA,
} from "../../lib/offres";

// Raccourcis vers les blocs. « Associations » se distingue par sa teinte,
// comme dans la maquette.
const RACCOURCIS = [
  { ancre: "#creation", libelle: "Création & refonte" },
  { ancre: "#audit", libelle: "Audit SEO" },
  { ancre: "#ia", libelle: "IA & automatisation" },
  { ancre: "#pilotage", libelle: "Pilotage de projet" },
  { ancre: "#associations", libelle: "Associations", teinte: true },
];

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((q) => ({
    "@type": "Question",
    name: q.question,
    acceptedAnswer: { "@type": "Answer", text: q.reponse },
  })),
};

const breadcrumb = [
  { nom: "Accueil", url: "/" },
  { nom: "Services", url: "/services/" },
];
---

<BaseLayout
  title="Services web au Mans : création, audit, IA, pilotage"
  description="Quatre offres aux prix affichés : création et refonte de site, audit SEO, IA et automatisation, pilotage de projet. Au Mans et à distance."
  pageClass="services"
  pleineLargeur
  jsonLd={[faqPage]}
  breadcrumb={breadcrumb}
>
  <section class="services-entete">
    <div class="conteneur services-entete-bloc">
      <h1>Sites internet, IA & projets numériques, au Mans et à distance</h1>
      <p class="services-intro">
        Quatre offres, des prix affichés, et une seule interlocutrice du premier
        échange au suivi. Vous ne savez pas laquelle choisir ? On en parle
        30 minutes, sans engagement.
      </p>
      <p class="garanties">
        {
          GARANTIES_SERVICES.map((garantie, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{garantie}</span>
            </>
          ))
        }
      </p>
      <nav class="raccourcis" aria-label="Aller à une offre">
        {
          RACCOURCIS.map((raccourci) => (
            <a
              class:list={["raccourci", raccourci.teinte && "raccourci--sauge"]}
              href={raccourci.ancre}
            >
              {raccourci.libelle}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="services-offres">
    <div class="conteneur services-offres-bloc">
      {
        BLOCS.map((bloc) => (
          <BlocOffre
            bloc={bloc}
            projets={bloc.exemple ? [bloc.exemple] : []}
            ancre
          />
        ))
      }
      <BlocAssociations ancre />
      <p class="mention-tva">{MENTION_TVA}</p>
    </div>
  </section>

  <Methode />
  <Faq />
  <BandeAppel titre="Pas sûr de l'offre qui vous convient ?" />
</BaseLayout>
