---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, ZONE_DESSERVIE } from "../../lib/site";

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Refonte de site web",
  serviceType: "Refonte de site web",
  description: "Audit et refonte de sites web existants : modernisation du design, des performances et de l'accessibilité, sans perte de référencement.",
  provider: { "@id": `${SITE.url}/#professionalservice` },
  areaServed: ZONE_DESSERVIE,
  url: new URL(Astro.url.pathname, SITE.url).href,
};

const breadcrumb = [
  { nom: "Accueil", url: "/" },
  { nom: "Services", url: "/services/" },
  { nom: "Refonte de site web", url: Astro.url.pathname },
];
---

<BaseLayout
  title="Refonte de site web | Sukiweb - Sandra Pautonnier"
  description="Refonte de site web par une développeuse au Mans : audit de l'existant, modernisation du design et des performances, sans perdre votre référencement."
  pageClass="services"
  jsonLd={[service]}
  breadcrumb={breadcrumb}
>
  <section class="margin">
    <h1>Refonte de site web</h1>
    <p class="base-text">Votre site existe déjà mais ne vous ressemble plus, ou ne performe pas. Audit, reprise de l'existant et refonte maîtrisée.</p>

    <p class="base-text">
      Contenu détaillé de cette prestation à venir : le texte de cette page sera
      rédigé lors de la phase éditoriale.
    </p>

    <a href="/contact/" class="btn" aria-label="Demander un devis">Demander un devis</a>
  </section>
</BaseLayout>
