---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, ZONE_DESSERVIE } from "../../lib/site";

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Gestion de projet digital",
  serviceType: "Gestion de projet digital",
  description: "Cadrage du besoin, coordination des intervenants et suivi de projet web jusqu'à la mise en ligne.",
  provider: { "@id": `${SITE.url}/#professionalservice` },
  areaServed: ZONE_DESSERVIE,
  url: new URL(Astro.url.pathname, SITE.url).href,
};

const breadcrumb = [
  { nom: "Accueil", url: "/" },
  { nom: "Services", url: "/services/" },
  { nom: "Gestion de projet digital", url: Astro.url.pathname },
];
---

<BaseLayout
  title="Gestion de projet digital | Sukiweb - Sandra Pautonnier"
  description="Gestion de projet digital au Mans : cadrage du besoin, coordination des intervenants et suivi jusqu'à la mise en ligne, avec un interlocuteur unique."
  pageClass="services"
  jsonLd={[service]}
  breadcrumb={breadcrumb}
>
  <section class="margin">
    <h1>Gestion de projet digital</h1>
    <p class="base-text">Cadrage, coordination des intervenants et suivi jusqu'à la mise en ligne. Un interlocuteur unique pour votre projet web.</p>

    <p class="base-text">
      Contenu détaillé de cette prestation à venir : le texte de cette page sera
      rédigé lors de la phase éditoriale.
    </p>

    <a href="/contact/" class="btn" aria-label="Demander un devis">Demander un devis</a>
  </section>
</BaseLayout>
