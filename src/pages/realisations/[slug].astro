---
import { getCollection, type CollectionEntry } from "astro:content";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faArrowLeft } from "@fortawesome/free-solid-svg-icons";
import { faGithub } from "@fortawesome/free-brands-svg-icons";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectVisuel from "../../components/ProjectVisuel.astro";
import { estTagIA } from "../../lib/site";

export async function getStaticPaths() {
  const projets = await getCollection("projets");
  return projets
    .filter((projet) => !projet.data.brouillon)
    .map((projet) => ({
      params: { slug: projet.id },
      props: { projet },
    }));
}

interface Props {
  projet: CollectionEntry<"projets">;
}

const { projet } = Astro.props;
const d = projet.data;

// Aucun lien externe tant que le projet n'est pas en ligne : les fichiers
// des projets privés ou en développement n'en portent pas, cette garde
// évite qu'un oubli en publie un.
const lienVisible = d.statut === "en-ligne" && Boolean(d.lien);

// Mise en page transitoire : le gabarit définitif (fil d'Ariane, encadré
// infos, navigation projet précédent / suivant, « Autres projets »,
// bandeau d'appel) arrive à l'étape 5.
---

<BaseLayout
  title={`${d.nomCourt} : ${d.titreCarte} | Sandra Pautonnier`}
  description={d.resume.slice(0, 155)}
  pageClass="project-page"
  breadcrumb={[
    { nom: "Accueil", url: "/" },
    { nom: "Réalisations", url: "/realisations/" },
    { nom: d.nomCourt, url: `/realisations/${projet.id}/` },
  ]}
>
  <section class="project-container">
    <div class="project-header">
      <a href="/realisations/" class="btn back-link" aria-label="Retour aux réalisations">
        <FontAwesomeIcon icon={faArrowLeft} /> Retour
      </a>
      <h1>{d.titre}</h1>
      <p class="project-date">{d.mention} · {d.statutAffiche}</p>
    </div>

    <p class="project-resume">{d.resume}</p>

    <div class="project-meta">
      <div class="project-techs">
        <strong>Technologies &amp; Outils utilisés :</strong>
        <div class="tech-list">
          {
            d.competences.map((tech) => (
              <span class:list={["tag", estTagIA(tech) && "tag--ia"]}>{tech}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="project-detail">
      <ProjectVisuel projet={projet} variante="fiche" eager />

      <dl class="project-infos">
        {
          d.infos.map((info) => (
            <div>
              <dt>{info.label}</dt>
              <dd>{info.valeur}</dd>
            </div>
          ))
        }
      </dl>

      {
        (lienVisible || d.github) && (
          <div class="project-links">
            <div class="project-link-buttons">
              {lienVisible && d.lien && (
                <a href={d.lien.url} target="_blank" rel="noopener noreferrer">
                  {d.lien.libelle}
                </a>
              )}
              {d.github && (
                <a
                  href={d.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="github-button"
                  aria-label="Lien vers le dépôt GitHub"
                >
                  <FontAwesomeIcon icon={faGithub} /> GitHub
                </a>
              )}
            </div>
          </div>
        )
      }

      {
        d.sections.map((section) => (
          <div class="project-section">
            <h2>{section.titre}</h2>
            {section.texte && <p>{section.texte}</p>}
            {section.liste && (
              <ul class="todo-list">
                {section.liste.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      {
        d.temoignage && (
          <blockquote class="project-temoignage">
            <p>{d.temoignage.texte}</p>
            <footer>
              <strong>{d.temoignage.auteur}</strong>, {d.temoignage.fonction}
            </footer>
          </blockquote>
        )
      }
    </div>
  </section>
</BaseLayout>
