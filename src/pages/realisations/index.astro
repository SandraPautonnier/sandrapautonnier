---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCardLarge from "../../components/ProjectCardLarge.astro";
import BandeAppel from "../../components/BandeAppel.astro";

const projets = (await getCollection("projets"))
  .filter((p) => !p.data.brouillon)
  .sort((a, b) => a.data.ordre - b.data.ordre);

const estPerso = (type: string) => type === "personnel" || type === "formation";

const clients = projets.filter((p) => p.data.type === "client");
const perso = projets.filter((p) => estPerso(p.data.type));

const FILTRES = [
  { id: "tous", libelle: "Tous", compte: projets.length },
  { id: "client", libelle: "Clients", compte: clients.length },
  { id: "perso", libelle: "Projets perso", compte: perso.length },
];

// Deux groupes, dans l'ordre de la maquette. Un filtre masque le groupe
// entier plutôt que de le vider.
const GROUPES = [
  { id: "client", titre: "Projets clients", items: clients },
  { id: "perso", titre: "Projets personnels", items: perso },
];
---

<BaseLayout
  title="Réalisations : sites et projets web | Sandra Pautonnier"
  description="Sites internet et projets numériques réalisés au Mans : le besoin de départ, ce que j'ai fait et le résultat. Projets clients et projets personnels."
  pageClass="realisations"
  pleineLargeur
  breadcrumb={[
    { nom: "Accueil", url: "/" },
    { nom: "Réalisations", url: "/realisations/" },
  ]}
>
  <section class="realisations-entete">
    <div class="conteneur realisations-entete-bloc">
      <h1>Réalisations : sites internet et projets numériques</h1>
      <p class="realisations-intro">
        Chaque projet raconte le besoin de départ, ce que j'ai fait et le
        résultat. Les projets clients d'abord, puis mes projets personnels.
      </p>
      <div class="filtres" role="group" aria-label="Filtrer les projets">
        {
          FILTRES.map((filtre, i) => (
            <button
              type="button"
              class="filtre"
              data-filtre={filtre.id}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {filtre.libelle}{" "}
              <span class="filtre-compte">{filtre.compte}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="realisations-liste">
    <div class="conteneur realisations-groupes">
      {
        GROUPES.map((groupe) => (
          <div class="groupe-projets" data-groupe={groupe.id}>
            <h2 class="groupe-projets-titre">{groupe.titre}</h2>
            {groupe.items.map((projet) => (
              <ProjectCardLarge projet={projet} />
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <BandeAppel titre="Votre projet pourrait être le prochain." />
</BaseLayout>

<script>
  // Même filtre que sur l'accueil, appliqué ici aux deux groupes entiers.
  // « Tous » est l'état rendu au build : sans JavaScript, les 9 projets
  // restent affichés.
  const boutons = document.querySelectorAll<HTMLButtonElement>(".filtre");
  const groupes = document.querySelectorAll<HTMLElement>(".groupe-projets");

  boutons.forEach((bouton) => {
    bouton.addEventListener("click", () => {
      const filtre = bouton.dataset.filtre ?? "tous";
      boutons.forEach((b) => b.setAttribute("aria-pressed", String(b === bouton)));
      groupes.forEach((groupe) => {
        groupe.hidden = filtre !== "tous" && groupe.dataset.groupe !== filtre;
      });
    });
  });
</script>
