# Compression

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Cache pour les assets (1 an)

<FilesMatch "^.\*\.(jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot|js|css)$">
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
</FilesMatch>

# Cache pour HTML (1 heure)

<FilesMatch "\.html$">
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=3600, must-revalidate"
</IfModule>
</FilesMatch>

# Page 404 (le site est desormais genere en statique : plus de fallback SPA)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1. www -> domaine sans www ---
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- 2. Anciennes URLs du SPA React -> arborescence Astro ---
  # Pages projet : l'id numerique devient un slug lisible
  RewriteRule ^portfolio/1/?$ /realisations/speaktime/ [R=301,L]
  RewriteRule ^portfolio/2/?$ /realisations/le-mans-school-of-ai/ [R=301,L]
  RewriteRule ^portfolio/3/?$ /realisations/pulsar42/ [R=301,L]
  RewriteRule ^portfolio/5/?$ /realisations/kasa/ [R=301,L]

  # Projets retires du portfolio : renvoi vers la liste
  RewriteRule ^portfolio/4/?$ /realisations/ [R=301,L]
  RewriteRule ^portfolio/6/?$ /realisations/ [R=301,L]

  # Liste des projets
  RewriteRule ^portfolio/?$ /realisations/ [R=301,L]

  # Autres pages renommees
  RewriteRule ^profile/?$ /a-propos/ [R=301,L]
  RewriteRule ^legalnotice/?$ /mentions-legales/ [R=301,L]

  # /price : remplace la redirection provisoire vers / posee au nettoyage
  RewriteRule ^price/?$ /services/creation-site-internet-le-mans/ [R=301,L]

  # --- 3. Normalisation du slash final (coherent avec trailingSlash "always") ---
  # Couvre notamment /contact, /realisations/simulateur-de-devis et toute
  # ancienne URL sans slash. Exclut les fichiers reels (assets, sitemap, pdf).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>
